{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@push-based/cpu-prof": ["packages/cpu-prof/src/index.ts"],
      "@push-based/prof-dev-kit": ["packages/prof-dev-kit/src/index.ts"],
      "@push-based/test-utils": ["testing/test-utils/src/index.ts"]
    }
  }
}
