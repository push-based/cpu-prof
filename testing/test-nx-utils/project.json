{
  "name": "test-nx-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "testing/test-nx-utils/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "testing/test-nx-utils/dist",
        "tsConfig": "testing/test-nx-utils/tsconfig.lib.json",
        "main": "testing/test-nx-utils/src/index.ts"
      }
    },
    "lint": {},
    "unit-test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "testing/test-nx-utils/vitest.unit.config.ts"
      }
    }
  },
  "implicitDependencies": ["test-utils"],
  "tags": ["scope:shared", "type:testing"]
}
