{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "vitest.e2e.config.ts",
    "tests/**/*.e2e.test.ts",
    "tests/**/*.e2e.test.tsx",
    "tests/**/*.e2e.test.js",
    "tests/**/*.e2e.test.jsx",
    "src/**/*.d.ts"
  ]
}
