{
  "name": "@push-based/prof-dev-kit",
  "version": "1.0.4",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {},
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ansis": "^4.1.0",
    "bundle-require": "^5.0.0",
    "ora": "^5.4.1",
    "zod": "^3.23.8"
  },
  "nx": {
    "name": "prof-dev-kit",
    "targets": {
      "unit-test": {
        "executor": "@nx/vite:test",
        "options": {
          "config": "packages/{projectName}/vitest.unit.config.ts"
        }
      },
      "int-test": {
        "executor": "@nx/vite:test",
        "options": {
          "config": "packages/{projectName}/vitest.int.config.ts"
        }
      }
    },
    "tags": [
      "package"
    ]
  }
}
