{
  "name": "@push-based/cpu-prof",
  "version": "1.0.4",
  "description": "Collect, merge and visualize Node.js CPU profiles as Chrome trace files.",
  "license": "MIT",
  "homepage": "https://github.com/push-based/cpu-prof#readme",
  "bugs": {
    "url": "https://github.com/push-based/cpu-prof/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/push-based/cpu-prof.git",
    "directory": "packages/cpu-prof"
  },
  "keywords": [
    "cpu-profile",
    "cpuprofile",
    "profiling",
    "performance",
    "nodejs",
    "trace",
    "chrome-devtools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "bin": {
    "cpu-prof": "./dist/cpu-prof.esm.js"
  },
  "scripts": {},
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "ansis": "^3.1.2",
    "yargs": "^17.7.2"
  },
  "nx": {
    "name": "cpu-prof",
    "targets": {
      "unit-test": {
        "executor": "@nx/vitest:test",
        "options": {
          "config": "packages/{projectName}/vitest.unit.config.ts"
        }
      },
      "integration-test": {
        "executor": "@nx/vitest:test",
        "options": {
          "config": "packages/{projectName}/vitest.integration.config.ts"
        }
      },
      "help": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node packages/cpu-prof/dist/cpu-prof.esm.js --help"
        }
      },
      "reduce": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node packages/cpu-prof/dist/cpu-prof.esm.js trace-reduce"
        }
      },
      "measure": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node packages/cpu-prof/dist/cpu-prof.esm.js measure"
        }
      },
      "merge": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node packages/cpu-prof/dist/cpu-prof.esm.js merge"
        }
      }
    },
    "tags": [
      "package"
    ]
  }
}
