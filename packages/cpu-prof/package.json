{
  "name": "@push-based/cpu-prof",
  "version": "1.0.4",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.esm.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.d.ts",
      "import": "./src/index.esm.js",
      "require": "./src/index.cjs",
      "default": "./src/index.cjs"
    }
  },
  "bin": {
    "cpu-prof": "./dist/cpu-prof.esm.js"
  },
  "scripts": {},
  "files": [
    "src",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yargs": "^17.7.2",
    "@push-based/prof-dev-kit": "1.0.4",
    "vitest": "^3.0.0",
    "vite": "^6.0.0"
  },
  "nx": {
    "name": "cpu-prof",
    "targets": {
      "unit-test": {},
      "help": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node packages/cpu-prof/dist/cpu-prof.esm.js --help"
        }
      },
      "reduce": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node packages/cpu-prof/dist/cpu-prof.esm.js trace-reduce"
        }
      },
      "measure": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node packages/cpu-prof/dist/cpu-prof.esm.js measure"
        }
      },
      "merge": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node packages/cpu-prof/dist/cpu-prof.esm.js merge"
        }
      }
    },
    "tags": [
      "package"
    ]
  }
}
